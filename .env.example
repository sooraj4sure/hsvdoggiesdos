# Evenlyn Pet Grooming — copy to .env.local and fill in
MONGODB_URI=mongodb://localhost:27017/evenlyn-pet-grooming
# Use a long random string in production. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret
# Demo seed logins are documented in README.md (admin + patient)
# Admin WhatsApp number for new-booking alerts (shown in admin, no API call is made)
CLINIC_WHATSAPP=+15559876543
